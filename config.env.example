# OpenClaw 记忆整理 - 环境变量配置
# 复制此文件为 .env 并填入你的配置
# 也可直接设置为系统环境变量（推荐）

# ===========================================
# LLM Provider 配置
# ===========================================

# Provider 预设：deepseek / openai / moonshot / qwen / zhipu / siliconflow / custom
MM_LLM_PROVIDER=deepseek

# API Key（必填）
MM_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 以下两项通常自动从预设获取，仅 custom 或覆盖预设时需要设置
# MM_LLM_API_URL=https://api.deepseek.com/v1/chat/completions
# MM_LLM_MODEL=deepseek-v4-flash

# 请求配置
# MM_LLM_TIMEOUT=90
# MM_LLM_MAX_RETRIES=2

# ===========================================
# 路径配置（不设置则自动推导）
# ===========================================
# MM_PROJECT_ROOT=C:\Users\你的用户名\.openclaw\openclaw-memory-manager
# MM_OPENCLAW_ROOT=C:\Users\你的用户名\.openclaw
# MM_CONVERSATIONS_DIR=C:\Users\你的用户名\.openclaw\memory-tdai\conversations
# MM_WORKSPACE_DIR=C:\Users\你的用户名\.openclaw\workspace
# MM_NOTIFY_QUEUE=C:\ProgramData\MemoryManager\notify_queue

# ===========================================
# 向后兼容旧变量名
# ===========================================
# MEMORY_MANAGER_DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
